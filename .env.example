# Set ke "production" di server produksi. Kalau production DAN masih ada
# secret placeholder di bawah, server MENOLAK start (lihat app/main.py).
APP_ENV=development

DATABASE_URL=postgresql://absensi_user:password_aman@localhost:5432/absensi
ALLOWED_EMAIL_DOMAIN=smkxxx.sch.id
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# WAJIB diganti — minimal 32 karakter acak. Generate: openssl rand -base64 48
# Kalau nilai ini bocor / masih placeholder, JWT bisa dipalsukan siapa saja.
JWT_SECRET=ganti_dengan_string_acak_panjang_dan_rahasia

# WAJIB diganti sebelum production. Generate dengan:
# python -c "from app.services.crypto import generate_new_key; print(generate_new_key())"
# Simpan backup key ini di tempat aman TERPISAH dari server database —
# kalau hilang, semua data wajah tersimpan tidak bisa didekripsi lagi.
FACE_ENCRYPTION_KEY=ganti_dengan_hasil_generate_new_key

# Secret untuk endpoint pembersihan data wajah kedaluwarsa (POST
# /admin/retensi/bersihkan-wajah), dipanggil cron OS — lihat docs/DEPLOYMENT.md
# bagian retensi data. Generate: openssl rand -hex 32. Kosong = endpoint nonaktif.
RETENSI_CRON_SECRET=ganti_dengan_string_acak_panjang

